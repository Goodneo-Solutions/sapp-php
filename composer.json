{
    "name": "superroute/sapp",
    "description": "sApp for PHP: sign-in, the platform app API, Open Platform capabilities and Superroute webhook verification.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["superroute", "logistics", "delivery", "sdk", "webhooks"],
    "homepage": "https://github.com/Goodneo-Solutions/sapp-php",
    "authors": [{ "name": "Goodneo Solutions", "homepage": "https://superroute.ca" }],
    "support": {
        "docs": "https://open.superroute.ca/developer/sapp",
        "issues": "https://github.com/Goodneo-Solutions/sapp-php/issues",
        "source": "https://github.com/Goodneo-Solutions/sapp-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "suggest": {
        "ext-curl": "The default HTTP transport; without it the client falls back to PHP streams."
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": { "Superroute\\SApp\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "config": { "sort-packages": true }
}
